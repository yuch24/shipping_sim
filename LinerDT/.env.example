# LinerDT 环境配置

# OpenAI 兼容的 LLM API（用于 AI 对话功能）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# Cesium Ion Token（用于前端 3D 地球）
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# AIS Stream API Key（实时孪生模式真实数据，https://aisstream.io）
AISSTREAM_API_KEY=

# 后端配置
BACKEND_PORT=8000
FRONTEND_PORT=3000
